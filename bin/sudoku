#!/bin/sh
# Sudoku launcher: runs the app from the ~/.sudoku checkout.
# POSIX sh on purpose: iSH/Alpine have no bash by default.
APP_DIR="${SUDOKU_HOME:-$HOME/.sudoku}"

if [ ! -x "$APP_DIR/.venv/bin/python" ]; then
    echo "Sudoku is not installed correctly. Reinstall with:"
    echo "  curl -fsSL https://raw.githubusercontent.com/RaphaelA4U/sudoku/main/install.sh | sh"
    exit 1
fi

exec "$APP_DIR/.venv/bin/python" -m sudoku_app "$@"
